# systemd oneshot unit that upgrades the hub, started by
# fednet-hub-upgrade.path. It runs as root and does one thing: `fednet
# upgrade` reads the release the request names and deletes the request,
# asks the hub what it runs and refuses anything not newer, downloads the
# release's binary for this machine and its SHA256SUMS from fednet's GitHub
# releases, checks the sum, puts the binary at /usr/local/bin/fednet in one
# rename, and hands the hub off to it through the admin socket (the same
# as `systemctl reload fednet-hub`). It fails, with the reason in its
# journal, without touching the binary when the download does not check
# out; a handoff that fails leaves the old process serving the new binary
# in place, and the next request tries again. It can write only the
# binary's directory and the hub's runtime directory.

[Unit]
Description=upgrade the fednet hub to the requested release
After=fednet-hub.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/fednet upgrade \
    -request /run/fednet-hub/upgrade \
    -binary /usr/local/bin/fednet \
    -socket /run/fednet-hub/admin.sock

UMask=0022
NoNewPrivileges=yes
# Reading the request in the hub's directory (mode 0700, owned by fednet),
# deleting it, and connecting to the hub's socket need to override the
# file modes; nothing else does.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
ProtectSystem=strict
ReadWritePaths=/usr/local/bin /run/fednet-hub
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
