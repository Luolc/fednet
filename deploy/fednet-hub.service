# systemd unit for `fednet hub`. A template: copy it to
# /etc/systemd/system/fednet-hub.service and replace the lines marked
# "replace". It expects:
#   - a system user and group named fednet, which own nothing else;
#   - the fednet binary at /usr/local/bin/fednet;
#   - the hub config at /etc/fednet-hub/hub.json (see hub.example.json);
#   - four credential files, one credential each, put in place by the
#     deployment (paths below). systemd copies each into the service's own
#     credentials directory (%d), readable by this service alone, and the
#     hub reads them from there. Leave out both Slack lines, and their
#     flags, to run the hub without Slack; leave out the webhook to run it
#     without alerts; leave out the approval key to run it without
#     approvals (requests for approval are then refused).
# The database lives in /var/lib/fednet-hub (StateDirectory); the admin
# socket in /run/fednet-hub (RuntimeDirectory).
#
# To upgrade without a gap, put the new binary at /usr/local/bin/fednet and
# run `systemctl reload fednet-hub`: the hub starts a new process of the
# new binary, which takes over the port and the socket, then the old one
# finishes what it has in hand and exits. A new process that fails to start
# makes the reload fail and leaves the old one serving. The service is
# Type=notify so that systemd follows the main process across the handoff;
# NotifyAccess=all because the new process reports before it is the main
# one. A change to this unit, or a database migration the old binary cannot
# handle, needs `systemctl restart` instead.
#
# The hub upgrades itself the same way: on `/fednet upgrade` in Slack, or
# when it finds a new release, it writes the release's version to the
# upgrade request file (-upgrade-request, in RuntimeDirectory), and the
# root units fednet-hub-upgrade.path and fednet-hub-upgrade.service do the
# download and the handoff. Install those two units with this one.

[Unit]
Description=fednet hub
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
NotifyAccess=all
User=fednet
Group=fednet
# replace: where the deployment keeps the four credential files.
LoadCredential=slack-app-token:/etc/fednet-hub/credentials/slack-app-token
LoadCredential=slack-bot-token:/etc/fednet-hub/credentials/slack-bot-token
LoadCredential=alert-webhook:/etc/fednet-hub/credentials/alert-webhook
LoadCredential=approval-key:/etc/fednet-hub/credentials/approval-key
StateDirectory=fednet-hub
StateDirectoryMode=0700
RuntimeDirectory=fednet-hub
RuntimeDirectoryMode=0700
# replace: -listen with the address the clients reach the hub at, on the
# private network between the machines (the hub speaks plain HTTP, so not
# a public address). If that address belongs to a VPN interface, also order
# this unit after the VPN's service.
ExecStart=/usr/local/bin/fednet hub \
    -listen 127.0.0.1:8080 \
    -db /var/lib/fednet-hub/hub.db \
    -config /etc/fednet-hub/hub.json \
    -admin-socket %t/fednet-hub/admin.sock \
    -slack-app-token-file %d/slack-app-token \
    -slack-bot-token-file %d/slack-bot-token \
    -alert-webhook-file %d/alert-webhook \
    -approval-key-file %d/approval-key \
    -upgrade-request %t/fednet-hub/upgrade
ExecReload=/usr/local/bin/fednet hub handoff -socket %t/fednet-hub/admin.sock
Restart=on-failure
RestartSec=5s
# Exit 2 is a usage error; restarting does not fix it.
RestartPreventExitStatus=2

UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
